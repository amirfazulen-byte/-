# Токен Telegram-бота от @BotFather
BOT_TOKEN=123456:ABC...
# Ключ Claude API (https://platform.claude.com)
ANTHROPIC_API_KEY=sk-ant-...
# Ключ шифрования токенов WB. Сгенерировать:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Храните отдельно от базы; если потерять — продавцам придётся заново прислать токены.
TOKEN_ENCRYPTION_KEY=
# Ваш Telegram ID — для /stats, /setlimit и уведомлений о сбоях
ADMIN_TG_ID=
# Закрытый тест: продавец заходит по ссылке https://t.me/<бот>?start=<код>. Пусто — открыто всем.
INVITE_CODE=beta2026
# Модель и глубина размышлений. См. README про стоимость.
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low
POLL_MINUTES=15
DB_PATH=otvetbot.db
